<section class="py-5">
  <div class="grid grid-cols-3 items-center">
    <div class="justify-self-start">
      <a href="/" class="underline">back to home</a>
    </div>
    <div class="justify-self-center">
      <h2 class="text-xl"><%= @memo.title %></h2>
    </div>
    <div class="justify-self-end items-end">
      <p class="text-sm text-gray-500 items-end">last update:
        <%= @memo.updated_at.strftime("%F %H:%M") %></p>
    </div>
  </div>
  <hr class="my-5">

  <div><%= @memo.content %></div>
  <hr class="my-5">
  <a href="/memos/<%= @memo.id %>/edit" role="button">
    edit
  </a>
</section>
