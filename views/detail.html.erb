<section class="py-5">
  <%= yield %>
  <div class="flex justify-center text-red-500">
    <p><%= @error_message %></p>
  </div>
  <div><%= h @memo.content %></div>
  <hr class="my-5">
  <a href="/memos/<%= @memo.id %>/edit" role="button" class="btn">
    edit
  </a>
  <button class="btn btn-error" popovertarget="delete_confirm_modal">delete</button>
  <div id="delete_confirm_modal" class="modal"
    popover>
    <div class="modal-box">
      <div class="modal-action">
        <button
          class="btn btn-sm btn-circle btn-ghost"
          popovertarget="delete_confirm_modal"
          popovertargetaction="hide">✕</button>
      </div>
      <h3 class="text-lg font-bold">Caution</h3>
      <p class="py-4">This action cannot be undone.</p>
      <form action="/memos/<%= @memo.id %>" method="post">
        <div class="mt-6 flex justify-center">
          <input type="hidden" name="_method" value="delete">
          <input type="submit" value="delete" class="btn btn-error">
        </div>
      </form>
    </div>
  </div>
</section>
