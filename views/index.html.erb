<section class="py-5">
  <h2 class="text-xl">Memo list</h2>
  <hr class="my-5">
  <div class="flex justify-end">
    <div>
      <a href="/memos/new" role="button" class="btn btn-sm">+ memo</a>
    </div>
  </div>
  <p>
    <%= @memos.size.zero? ? "No memo created yet" : "memo count: " + @memos.size.to_s %>
  </p>
  <div class="mt-3">
    <ul role="list" class="list rounded-box">
      <% @memos.each do |memo| %>
        <li class="list-row flex items-end justify-between">
          <div class="text-lg ">
            <a href="/memos/<%= memo.id %>/detail"><%= memo.title %></a>
          </div>
          <div>- (last update:
            <%= memo.updated_at.strftime("%F %H:%M") %>)
          </div>

        </li>
      <% end %>
    </ul>
  </div>
</section>
