<section class="py-5">
  <h2 class="text-xl">Memo list</h2>
  <a href="/memos/new" role="button" class="btn btn-sm">+ memo</a>
  <hr class="py-5">
  <p>
    <%= @memos.size.zero? ? "No memo created yet" : "memo count: " + @memos.size.to_s %>
  </p>
  <div class="">
    <ul>
      <% @memos.each do |memo| %>
        <li>
          <p>
            <a href="/memos/<%= memo.id %>/detail"><%= memo.title %></a>
            <span>- (last update:
              <%= memo.updated_at.strftime("%F %H:%M") %>)
            </span>
          </p>
        </li>
      <% end %>
    </ul>
  </div>
</section>
